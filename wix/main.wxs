<!--
  Instalador WiX 4 do Simion (Windows).

  Este arquivo existe porque o template default gerado por `cargo wix init`
  NÃO cria atalho no Menu Iniciar, não instala ícone de aplicativo e não
  oferece escolha de diretório. Versionar o .wxs garante que cada release
  carregue estas correções (ver issues #1 e #2 do repositório).

  Build (no job windows do CI):
    cargo wix -I wix/main.wxs   (acrescente a flag de log verboso se precisar)
  Variáveis do cargo-wix usadas: $(var.CargoTargetBinDir), $(var.Version).
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <!-- A extensão WixToolset.UI.wixext fornece os diálogos (WixUI_InstallDir). -->
    <Package
        Name="Simion"
        UpgradeCode="7C1E9B54-3A6D-4E2F-9B18-5D3C2A8F0BE1"
        Manufacturer="Simion"
        Language="1046"
        Codepage="1252"
        Version="$(var.Version)"
        InstallerVersion="500"
        Scope="perMachine">

        <SummaryInformation
            Keywords="Installer"
            Manufacturer="Simion"
            Description="Simion — caderno de blocos local"/>

        <!-- Upgrade: remove a versão anterior em vez de acumular entradas. -->
        <MajorUpgrade
            Schedule="afterInstallInitialize"
            DowngradeErrorMessage="Uma versão mais nova do Simion já está instalada. O instalador vai fechar."/>

        <MediaTemplate EmbedCab="yes"/>

        <!--
          Escolha do diretório: sem WIXUI_INSTALLDIR o instalador instala em
          Program Files\Simion sem perguntar nada.
        -->
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER"/>
        <ui:WixUI Id="WixUI_InstallDir"/>

        <!-- Metadados de Apps instalados (#3): ícone, ajuda e comentário. -->
        <Icon Id="ProductICO" SourceFile="assets\branding\simion.ico"/>
        <Property Id="ARPPRODUCTICON" Value="ProductICO"/>
        <Property Id="ARPNOREPAIR" Value="1"/>
        <!-- ARPNOMODIFY vem da WixUI_InstallDir: declarar aqui gera WIX0091. -->
        <Property Id="ARPCOMMENTS" Value="Simion — caderno de blocos local. Markdown, tarefas, hierarquia de páginas e SQLite, tudo offline."/>
        <Property Id="ARPHELPLINK" Value="https://github.com/cleisonsantos/simion"/>
        <Property Id="ARPPUBLISHER" Value="Simion"/>
        <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize"/>

        <Feature
            Id="Main"
            Title="Simion"
            Description="Instala o Simion, o atalho do Menu Iniciar/Desktop e a documentação."
            Level="1"
            ConfigurableDirectory="INSTALLFOLDER"
            AllowAbsent="no"
            Display="expand">
            <ComponentRef Id="MainExecutable"/>
            <ComponentRef Id="ReadmeFile"/>
            <ComponentRef Id="LicenseFile"/>
        </Feature>

        <StandardDirectory Id="$(var.PlatformProgramFilesFolder)">
            <Directory Id="INSTALLFOLDER" Name="Simion">
                <!--
                  O executável fica na RAIZ da pasta de instalação
                  (não em \bin como no template default), para o atalho e o
                  "Abrir local do arquivo" fazerem sentido para o usuário.
                -->
                <Component Id="MainExecutable" Guid="*">
                    <File Id="SimionExe"
                          Name="simion.exe"
                          DiskId="1"
                          Source="$(var.CargoTargetBinDir)\simion.exe"
                          KeyPath="yes">
                        <!--
                          Os dois atalhos ficam NÃO-ANUNCIADOS de propósito (#7).

                          O shell monta o ícone do atalho a partir do próprio
                          simion.exe, que já embute os recursos de ícone. Um
                          atalho anunciado aponta para o ProductCode da feature
                          e, junto com Icon= apontando para o .ico cru da tabela
                          Icon, deixa o atalho sem ícone: para atalhos a
                          Microsoft exige um binário EXE com a mesma extensão do
                          alvo, o que o .ico não é.

                          Os atalhos estão aninhados no <File> de propósito: o
                          WiX grava Target="[!SimionExe]" na tabela Shortcut
                          (caminho completo do executável instalado). O atributo
                          Target explícito NÃO pode ser usado aqui — o WiX 6
                          aborta com IllegalAttributeWhenNested; aninhado no
                          <File>, o alvo padrão já é o próprio arquivo.
                        -->
                        <Shortcut Id="DesktopShortcut"
                                  Directory="DesktopFolder"
                                  Name="Simion"
                                  Description="Caderno de blocos local"
                                  WorkingDirectory="INSTALLFOLDER"
                                  Advertise="no">
                            <!-- Liga o atalho ao processo (mesmo ID que
                                 SetCurrentProcessExplicitAppUserModelID usa). Sem
                                 isso o shell nao associa atalho <-> executavel e
                                 o icone do atalho pode sair em branco (#7). -->
                            <ShortcutProperty Id="DesktopShortcutAUMID"
                                              Key="System.AppUserModel.ID"
                                              Value="com.cleisonsantos.simion"/>
                        </Shortcut>
                        <Shortcut Id="ApplicationStartMenuShortcut"
                                  Directory="ApplicationProgramsFolder"
                                  Name="Simion"
                                  Description="Caderno de blocos local"
                                  WorkingDirectory="INSTALLFOLDER"
                                  Advertise="no">
                            <!-- Ver comentario do DesktopShortcut: mesmo AppUserModel.ID. -->
                            <ShortcutProperty Id="StartMenuShortcutAUMID"
                                              Key="System.AppUserModel.ID"
                                              Value="com.cleisonsantos.simion"/>
                        </Shortcut>
                    </File>
                    <!-- Remove a pasta do Menu Iniciar no uninstall, se ficar
                         vazia. Fica no componente do executavel: o atalho do
                         Menu Iniciar tambem vive aqui agora (#7). -->
                    <RemoveFolder Id="CleanUpShortcutFolder"
                                  Directory="ApplicationProgramsFolder"
                                  On="uninstall"/>
                </Component>

                <Component Id="ReadmeFile" Guid="*">
                    <File Id="README"
                          Name="README.md"
                          DiskId="1"
                          Source="README.md"
                          KeyPath="yes"/>
                </Component>

                <Component Id="LicenseFile" Guid="*">
                    <File Id="LICENSE"
                          Name="LICENSE"
                          DiskId="1"
                          Source="LICENSE"
                          KeyPath="yes"/>
                </Component>
            </Directory>
        </StandardDirectory>

        <!--
          Pasta do Menu Iniciar (#1): ProgramMenuFolder\Simion. Só a pasta é
          declarada aqui — o atalho que mora nela é um Shortcut aninhado no
          <File Id="SimionExe"> do componente MainExecutable (#7). Não existe
          mais um componente `ApplicationShortcut`.
        -->
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="Simion"/>
        </StandardDirectory>
    </Package>
</Wix>
